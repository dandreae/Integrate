EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Pedestrian routing (see services/routing/). Defaults to the public,
# no-signup-required Valhalla OSM demo server — override only if pointing at
# a self-hosted or paid routing instance.
EXPO_PUBLIC_ROUTING_BASE_URL=
# Unused by the default Valhalla demo server; reserved for providers that require one.
EXPO_PUBLIC_ROUTING_API_KEY=

# Accessibility reports (see services/repositories/AccessibilityReportRepository.ts).
# "mock" (default, or unset): seeded demo data from data/accessibilityReports.ts, in-memory only.
# "live": real Firestore-backed reports, shared across users in real time.
EXPO_PUBLIC_ACCESSIBILITY_REPORTS_MODE=

# Discover feed (see services/repositories/DiscoverPostRepository.ts).
# "mock" (default, or unset): seeded demo data from data/discoverPosts.ts, in-memory only.
# "live": real Firestore-backed feed, shared across users in real time.
EXPO_PUBLIC_DISCOVER_MODE=

# Campus events (see services/repositories/EventRepository.ts).
# "mock" (default, or unset): curated seed data from data/events.ts, no network.
# "live": fetches Georgetown's public LiveWhale events calendar and caches
# the result in Firestore (services/repositories/firestore/eventsCache.ts).
EXPO_PUBLIC_EVENTS_MODE=
# Only used in "live" mode. Defaults to https://events.georgetown.edu — override only for a different LiveWhale-hosted calendar.
EXPO_PUBLIC_EVENTS_BASE_URL=
