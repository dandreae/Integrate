rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Approved renames/zones are written only by Cloud Functions (the admin
    // SDK bypasses these rules), once a proposal crosses the confirmation
    // threshold.
    match /placeOverrides/{placeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /constructionZones/{zoneId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /proposals/{proposalId} {
      allow read: if signedIn();

      // Clients may create a proposal, but status/confirmCount are
      // server-controlled from then on (mutated only by Cloud Functions).
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.confirmCount == 0;
      allow update, delete: if false;

      match /confirmations/{uid} {
        allow read: if signedIn();

        // Doc ID == uid, so a repeat attempt targets an existing document —
        // Firestore treats that as an update, which is disallowed below,
        // giving idempotent "one vote per distinct uid" counting for free.
        // Self-confirmation is blocked here too (mirrored again in the
        // onConfirmationCreated Cloud Function as defense in depth).
        allow create: if signedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/proposals/$(proposalId)).data.submittedBy != request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
